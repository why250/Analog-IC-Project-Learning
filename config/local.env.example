# Copy to config/local.env and edit on EACH EDA host. Bash syntax.
# This file contains paths only; configure tool licenses through your site environment.
export CADENCE_VERIFICATION_ROOT="$HOME/AAAIC/tutorials/cadence_verification"
export ADC_PROJECTS_ROOT="$HOME/AAAIC/adc_projects"
export ADC_LEARNING_ROOT="$HOME/AAAIC/adc_learning"
export AFE4404_ROOT="$HOME/AAAIC/afe_projects/afe4404"
export AFE4404_WORKSPACE="$HOME/AAAIC/workspaces/afe4404"
export AFE4404_PDK_ROOT="$HOME/AAAIC/pdks/gf018hv_green"
export CDSHOME="/opt/eda/cadence/IC251"
export VIRTUOSO_BRIDGE_ROOT="$HOME/virtuoso-bridge-lite"
# Optional: Windows client uses SSH; the paths above still belong to the EDA host.
# export IC_SERVER_SSH_ALIAS="IC_Server"
# export WINDOWS_BRIDGE_ROOT="D:/path/to/virtuoso-bridge-lite"
# export COURSE_REMOTE_ROOT="$HOME/.local/state/analog-ic-project-learning"
# Set DISPLAY / XAUTHORITY only after verifying the intended remote desktop.
